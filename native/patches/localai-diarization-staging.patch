+package nodes
+
+import (
+ "context"
+ "errors"
+ "strings"
+ "testing"
+ grpc "github.com/mudler/LocalAI/pkg/grpc"
+ pb "github.com/mudler/LocalAI/pkg/grpc/proto"
+ ggrpc "google.golang.org/grpc"
+)
+
+type diarizationStagingBackend struct {
+ grpc.Backend
+ received string
+ failure error
+}
+func (b *diarizationStagingBackend) Diarize(_ context.Context, in *pb.DiarizeRequest, _ ...ggrpc.CallOption) (*pb.DiarizeResponse, error) {
+ b.received = in.Dst
+ return &pb.DiarizeResponse{}, b.failure
+}
+func TestDiarizationFileStaging(t *testing.T) {
+ for _, failure := range []error{nil, errors.New("native inference failed")} {
+  backend := &diarizationStagingBackend{failure: failure}
+  stager := &lifecycleStager{}
+  client := NewFileStagingClient(backend, stager, "worker-1")
+  request := &pb.DiarizeRequest{Dst: "/tmp/source.wav"}
+  _, err := client.Diarize(context.Background(), request)
+  if err != failure || request.Dst != "/tmp/source.wav" || !strings.HasPrefix(backend.received, "/remote/") || len(stager.releasedKeys) != 1 {
+   t.Fatalf("staging lifecycle mismatch: err=%v original=%s staged=%s released=%d", err, request.Dst, backend.received, len(stager.releasedKeys))
+  }
+ }
+}
