 // SetupTestDB creates a fresh PostgreSQL 16 container and returns a gorm.DB.
 // The container is cleaned up via DeferCleanup when the test completes.
 func SetupTestDB() *gorm.DB {
+	if dsn:=os.Getenv("LOCALAI_TEST_POSTGRES_DSN");dsn!=""{
+		schema:="native_test_"+strings.ReplaceAll(uuid.NewString(),"-","")
+		options:=&gorm.Config{Logger:logger.Default.LogMode(logger.Silent)}
+		owner,err:=gorm.Open(postgres.Open(dsn),options);Expect(err).ToNot(HaveOccurred())
+		Expect(owner.Exec("CREATE SCHEMA "+schema).Error).To(Succeed())
+		DeferCleanup(func(){owner.Exec("DROP SCHEMA "+schema+" CASCADE");sqlDB,_:=owner.DB();sqlDB.Close()})
+		db,err:=gorm.Open(postgres.Open(dsn+" search_path="+schema),options);Expect(err).ToNot(HaveOccurred())
+		DeferCleanup(func(){sqlDB,_:=db.DB();sqlDB.Close()})
+		return db
+	}
